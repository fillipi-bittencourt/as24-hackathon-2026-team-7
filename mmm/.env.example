# Environment variable fallback for API keys.
# This file is now the easiest local default source for API keys.
# Preferred local method: copy .env.example -> .env and fill in your keys.
# The app still supports credentials.json, shell env vars, and manual sidebar override.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
